# ---- Server ----
NODE_ENV=development
PORT=4000

# ---- MongoDB ----
# MongoDB Atlas connection string (Atlas clusters are replica sets, which the app
# needs for transactions). Use a separate database name for demo data, e.g.
# tractor_tracker_demo, so it never mixes with real business records.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/tractor_tracker?retryWrites=true&w=majority

# ---- Auth ----
# Long random string (at least 32 characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=30d

# ---- CORS ----
# Native mobile apps do not send an Origin header, so CORS only matters for
# browsers. Comma-separated list of allowed web origins (leave empty to block all).
CORS_ORIGINS=

# ---- Business timezone (used for "today" and driver cycles) ----
BUSINESS_TIMEZONE=Asia/Kolkata
