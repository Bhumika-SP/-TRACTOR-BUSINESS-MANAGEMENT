# Address of the Tractor Tracker backend, ending in /api.
# Local development: use your computer's Wi-Fi IP (not "localhost") so the phone can reach it,
#   e.g. http://192.168.1.10:4000/api
# Production: your Render URL, e.g. https://tractor-tracker-api.onrender.com/api
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000/api
